# Copy to .env for local dev (never committed — see .gitignore). In AWS, these
# come from SSM Parameter Store instead, fetched at container start; this file
# is also the authoritative list of what needs a Parameter Store entry there.
#
# PORT is intentionally NOT here — docker-compose.yml / the nodemon.*.json
# configs set it per-service (api=8082, paper=8080, real=8081).

# ---- Alpaca — REQUIRED ------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "paper" or "live". Leave as paper until real-trading is deliberately enabled —
# see the AWS deployment plan note on why real-trading ships later, not day one.
ALPACA_TRADING_MODE=paper
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_PAPER_STREAM_URL=wss://paper-api.alpaca.markets/stream
ALPACA_LIVE_STREAM_URL=wss://api.alpaca.markets/stream

# ---- Supabase — REQUIRED -----------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — see requireAuth.ts for why that's deliberate
# here. Treat this one as the most sensitive value in this file.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- Server -------------------------------------------------------------------
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info

# ---- Rolling window / risk defaults ----------------------------------------
DEFAULT_ROLLING_WINDOW_MS=60000
MAX_POSITION_SIZE_USD=10000
MAX_NOTIONAL_EXPOSURE_USD=50000
ORDER_COOLDOWN_MS=5000

# ---- Feature flags ----------------------------------------------------------
ENABLE_LIVE_TRADING=false
ENABLE_WEBSOCKET_PUSH=true

# ---- Portfolio ----------------------------------------------------------------
INITIAL_CAPITAL=100000

# ---- Optional startup strategy (standalone/debug only) ---------------------
# Leave both empty in normal use — the frontend manages strategies via the API.
STARTUP_LEG1=
STARTUP_LEG2=
