# Copy to .env for local dev (never committed — see .gitignore). In AWS, these
# come from SSM Parameter Store instead, fetched at container start; this file
# is also the authoritative list of what needs a Parameter Store entry there.
#
# PORT is intentionally NOT here — docker-compose.yml / the nodemon.*.json
# configs set it per-service (api=8082, paper=8080, real=8081).

# ---- Alpaca — REQUIRED ------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "paper" or "live". Leave as paper until real-trading is deliberately enabled —
# see the AWS deployment plan note on why real-trading ships later, not day one.
ALPACA_TRADING_MODE=paper
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_PAPER_STREAM_URL=wss://paper-api.alpaca.markets/stream
ALPACA_LIVE_STREAM_URL=wss://api.alpaca.markets/stream

# ---- Supabase — REQUIRED -----------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — see requireAuth.ts for why that's deliberate
# here. Treat this one as the most sensitive value in this file.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for `npm run db:migrate` / `db:status` / `db:verify` only —
# the running app never uses it. Dashboard → Connect → Session pooler.
DATABASE_URL=
# Optional: Supabase root CA (Database → SSL Configuration → Download) so the
# migration tools verify the server certificate instead of trusting any.
DATABASE_CA_CERT=

# ---- Live runner (Part 05) ----------------------------------------------------
# How long a trading process's claim on a strategy run survives without a
# heartbeat. A peer adopts a run this long after its runner dies.
RUN_LEASE_SECONDS=90
# evaluate() errors in a row before a live strategy is auto-disabled.
MAX_CONSECUTIVE_STRATEGY_ERRORS=5

# ---- Backtest worker (Part 02) — npm run dev:worker ---------------------------
BACKTEST_WORKER_LEASE_SECONDS=60
# Concurrently running backtests per member, so one sweep can't starve the queue.
BACKTEST_PER_USER_CAP=2
# Worker crashes on the same job before it is failed as poison.
BACKTEST_MAX_ATTEMPTS=3
# How long an unsaved result stays saveable.
BACKTEST_RESULT_TTL_SECONDS=1800

# ---- Server -------------------------------------------------------------------
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info

# ---- Rolling window / risk defaults ----------------------------------------
DEFAULT_ROLLING_WINDOW_MS=60000
MAX_POSITION_SIZE_USD=10000
MAX_NOTIONAL_EXPOSURE_USD=50000
ORDER_COOLDOWN_MS=5000

# ---- Feature flags ----------------------------------------------------------
ENABLE_LIVE_TRADING=false
ENABLE_WEBSOCKET_PUSH=true

# ---- Portfolio ----------------------------------------------------------------
INITIAL_CAPITAL=100000

# ---- Optional startup strategy (standalone/debug only) ---------------------
# Leave both empty in normal use — the frontend manages strategies via the API.
STARTUP_LEG1=
STARTUP_LEG2=
