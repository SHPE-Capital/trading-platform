# Copy to .env for local dev (never committed — see .gitignore). In AWS, these
# come from SSM Parameter Store instead, fetched at container start; this file
# is also the authoritative list of what needs a Parameter Store entry there.
#
# PORT is intentionally NOT here — docker/docker-compose.local.yml / the config/nodemon/*.json
# configs set it per-service (api=8082, paper=8080, real=8081).

# ---- Execution ---------------------------------------------------------------
# Where a trading runtime sends orders:
#   sim           (default) fill locally against market data; no broker keys
#   alpaca-paper  the Alpaca paper account behind ALPACA_API_KEY
#   alpaca-live   real money (real-trading runtime only)
# The club's shared account (config/protectedAccounts.ts) is refused at boot
# unless APP_RUNTIME_ORIGIN is its deployment (aws-prod). Members testing against
# a broker use their OWN Alpaca paper keys.
EXECUTION_TARGET=sim
# development permits experimental strategies on sim and your personal paper account.
# Use shared on shared accounts. Real-money trading always requires ready + approval.
STRATEGY_POLICY_PROFILE=development
# How a sim runtime streaming live data fills orders: quote (default) against
# the stream's quotes and trades, SIM_LATENCY_MS after each decision, as in a
# quote-model backtest; bar on the next bar's open. A replay always uses bars.
# On the IEX stream (the default URL) quotes are IEX's own book, often wider
# than the national best.
SIM_EXECUTION_MODEL=quote
SIM_LATENCY_MS=250
# Mandatory on aws-prod: the account number the keys must resolve to.
EXPECTED_BROKER_ACCOUNT=
# How often a trading runtime copies the broker's orders/fills into the ledger
# and checks for drift (see docs/broker-ledger.md).
BROKER_SYNC_INTERVAL_MS=60000
# Buy-and-hold benchmark shown beside run and strategy performance.
BENCHMARK_SYMBOL=SPY

# ---- Alpaca ------------------------------------------------------------------
# Trading keys — required only for the alpaca targets.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Market-data keys (stream, bars, market clock). Default to the trading keys.
# REQUIRED to run strategies: use your OWN free Alpaca paper account's keys
# (https://app.alpaca.markets -> Paper Trading -> API Keys). Without keys a
# trading runtime receives no data and refuses new runs; backtests use cached bars only.
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=
# "paper" or "live". Leave as paper until real-trading is deliberately enabled —
# see the AWS deployment plan note on why real-trading ships later, not day one.
ALPACA_TRADING_MODE=paper
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_PAPER_STREAM_URL=wss://paper-api.alpaca.markets/stream
ALPACA_LIVE_STREAM_URL=wss://api.alpaca.markets/stream
# Historical quotes/trades for quote-based backtest fills. The free plan allows
# 200 requests/min per key (SIP history older than 15 minutes is included);
# fetched windows are cached on disk under MARKET_DATA_DIR (gitignored).
ALPACA_DATA_REQUESTS_PER_MINUTE=190
MARKET_DATA_DIR=.local/marketdata
# Unusable market data (one-sided/crossed quotes, non-positive prices, bad
# timestamps): quarantine (default) drops it before prices and strategies see
# it; pass publishes it unchanged, as before 2026-10.
MARKET_DATA_INVALID_POLICY=quarantine

# ---- Latency instrumentation (optional) -----------------------------------------
# Observes a trading runtime's own market-data stream and order path without
# changing what it does. See docs/guides/latency-benchmark.md.
LATENCY_PROBE=false
# Where to write; must not exist yet. Default: artifacts/latency/<run-id>.
LATENCY_PROBE_DIR=
# Fraction of frames whose detail is kept; histograms always see every event.
LATENCY_PROBE_SAMPLE=0.01
# frame (low overhead) | stage (per-event spans, for diagnosis)
LATENCY_PROBE_DETAIL=frame
LATENCY_PROBE_EXPORT_SECONDS=60
# Also record this runtime's inbound frames for replay (bounded by the cap).
LATENCY_RECORD=false
LATENCY_RECORD_MAX_MB=2048

# ---- Replay recording ---------------------------------------------------------
# Record this runtime's event stream and save it to event_logs on graceful
# shutdown (Ctrl+C / SIGTERM), for npm run dev:replay. See docs/guides/replay.md.
REPLAY_RECORD=false
# Events held in memory; beyond this the oldest are dropped.
REPLAY_RECORD_MAX_EVENTS=200000

# ---- Supabase — REQUIRED -----------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — see requireAuth.ts for why that's deliberate
# here. Treat this one as the most sensitive value in this file.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for `npm run db:migrate` / `db:status` / `db:verify` only —
# the running app never uses it. Dashboard → Connect → Session pooler.
DATABASE_URL=
# Optional: Supabase root CA (Database → SSL Configuration → Download) so the
# migration tools verify the server certificate instead of trusting any.
DATABASE_CA_CERT=

# ---- Live runner (Part 05) ----------------------------------------------------
# How long a trading process's claim on a strategy run survives without a
# heartbeat. A peer adopts a run this long after its runner dies.
RUN_LEASE_SECONDS=90
# evaluate() errors in a row before a live strategy is auto-disabled.
MAX_CONSECUTIVE_STRATEGY_ERRORS=5
# Strategy diagnostics: warn when a strategy's symbol has produced no data for
# this long while the market is open (a typo'd or unavailable symbol, a dead feed)...
DIAGNOSTICS_NO_DATA_SECONDS=300
# ...and log a repeated blocked/rejected order once per window, with a count of the rest.
DIAGNOSTICS_LOG_WINDOW_SECONDS=60
# Hard ceiling applied server-side to member-started paper sandbox runs.
SANDBOX_MAX_CAPITAL_PCT=0.05
# Concurrent self-service paper runs per active member.
SANDBOX_MAX_ACTIVE_RUNS_PER_MEMBER=2
# Sandbox runs stop automatically after this many hours.
SANDBOX_RUN_TTL_HOURS=24

# ---- Backtest worker (Part 02) — npm run dev:worker ---------------------------
BACKTEST_WORKER_LEASE_SECONDS=60
# Concurrently running backtests per member, so one sweep can't starve the queue.
BACKTEST_PER_USER_CAP=2
# Worker crashes on the same job before it is failed as poison.
BACKTEST_MAX_ATTEMPTS=3
# How long an unsaved result stays saveable.
BACKTEST_RESULT_TTL_SECONDS=1800

# ---- Server -------------------------------------------------------------------
NODE_ENV=development
# Deployment boundary: aws-prod in production, anything else locally.
APP_RUNTIME_ORIGIN=local
# CI/deploy should set the commit SHA and false; local defaults remain obvious.
APP_BUILD_SHA=local
APP_BUILD_DIRTY=true
# Comma-separated exact origins; one-label wildcards support preview hosts.
CORS_ORIGIN=http://localhost:3000,https://*.vercel.app

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info

# ---- Rolling window / risk defaults ----------------------------------------
DEFAULT_ROLLING_WINDOW_MS=60000
MAX_POSITION_SIZE_USD=10000
MAX_NOTIONAL_EXPOSURE_USD=50000
ORDER_COOLDOWN_MS=5000

# ---- Feature flags ----------------------------------------------------------
ENABLE_LIVE_TRADING=false
ENABLE_WEBSOCKET_PUSH=true

# ---- Portfolio ----------------------------------------------------------------
INITIAL_CAPITAL=100000

# ---- Optional startup strategy (standalone/debug only) ---------------------
# Leave both empty in normal use — the frontend manages strategies via the API.
STARTUP_LEG1=
STARTUP_LEG2=
