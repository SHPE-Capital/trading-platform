# Copy to ~/app/.env ON THE SERVER (chmod 600). Never commit the real file.
# Superset of backend/.env.example; only what production needs is listed.

DOMAIN=                      # e.g. example.com or 203-0-113-5.sslip.io

NODE_ENV=production
APP_RUNTIME_ORIGIN=aws-prod
# Your Vercel URL(s), comma-separated, exact origins.
CORS_ORIGIN=https://your-app.vercel.app

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sim = no broker, safe for first deploy. Use alpaca-paper with the club or your
# own paper keys once ready (aws-prod requires EXPECTED_BROKER_ACCOUNT for it).
EXECUTION_TARGET=sim
EXPECTED_BROKER_ACCOUNT=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=
ALPACA_TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
ENABLE_WEBSOCKET_PUSH=true
LOG_LEVEL=info
