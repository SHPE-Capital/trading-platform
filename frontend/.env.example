# Public browser configuration. Copy to .env.local for development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_BACKTEST_API_BASE_URL=http://localhost:8082/api
NEXT_PUBLIC_LIVE_API_BASE_URL=http://localhost:8081/api
NEXT_PUBLIC_ENABLE_WEBSOCKET=true
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080
NEXT_PUBLIC_APP_NAME=SHPE Capital Trading Platform

# Supabase's public project URL and anon key. Never put the service-role key in
# a NEXT_PUBLIC variable; these values are compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
